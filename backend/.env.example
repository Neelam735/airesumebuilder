# Razorpay (use TEST keys for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_AMOUNT=2900
RAZORPAY_CURRENCY=INR

# Grok (xAI) — OpenAI-compatible API
# Valid models: grok-3, grok-3-mini, grok-3-fast, grok-3-mini-fast, grok-2-1212
GROK_API_KEY=xai-xxxxxxxx
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
# Set to true ONLY if your model supports response_format=json_object
GROK_JSON_MODE=false

# Server
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
