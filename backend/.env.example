# --- Google Play Billing -----------------------------------------------------
# Android package name registered in Google Play Console
GOOGLE_PLAY_PACKAGE_NAME=com.resumebuilder.app
# In-app product id (consumable) configured in Play Console
GOOGLE_PLAY_PRODUCT_ID=ai_resume_improvement
# Service-account JSON path or full JSON content. The service account must be
# linked in Play Console → Users and permissions → API access, with at least
# "View financial data" permission for this app.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/etc/secrets/play-service-account.json
# 32+ random bytes; used to HMAC-sign internal payment tokens
PAYMENT_TOKEN_SIGNING_KEY=replace_with_at_least_32_random_bytes

# --- Gemini (Google AI Studio) ----------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JSON_MODE=true

# --- Server ------------------------------------------------------------------
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
